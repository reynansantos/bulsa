                  <div style=\{\{ display:"flex", gap:6 \}\}><Inp value=\{gInput\} onChange=\{setGInput\} placeholder="Add grocery item price (e.g. Eggs 90)..." onKeyDown=\{e=>e.key==="Enter"&&(setGItems([...gItems,\{id:uid(),text:gInput,checked:false\}]),setGInput(""))\}/><Btn onClick=\{()=>\{if(gInput.trim())\{setGItems([...gItems,\{id:uid(),text:gInput,checked:false\}]);setGInput("");\}\}\} style=\{\{ width:"auto", padding:"0 14px" \}\}>+</Btn></div>\
