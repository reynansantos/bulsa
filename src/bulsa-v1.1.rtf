                  \{gItems.length>0 && <button onClick=\{()=>\{let sum=0; gItems.forEach(i=>\{const m=i.text.match(/\\d+$/); if(m) sum+=parseFloat(m[0]);\}); if(sum>0) setAmount(String(sum));\}\} style=\{\{ background:"none", border:"none", color:C.lime, fontSize:11, cursor:"pointer", textAlign:"left" \}\}>\uc0\u9881 \u65039  Compute & fill sum total amount?</button>\}\
                </div>\
              )\}\
            </div>\
            <Btn onClick=\{()=>valid && setStep(1)\} style=\{\{ opacity:valid?1:0.4 \}\}>Continue Step \uc0\u8594 </Btn>\
          </div>\
        ) : (\
          <div style=\{\{ display:"flex", flexDirection:"column", gap:16 \}\}>\
            <SLabel>Psychological Emotional Budget State</SLabel>\
            <div style=\{\{ display:"grid", gridTemplateColumns:"repeat(4,1fr)", gap:8 \}\}>\
              \{MOODS.map(m=><button key=\{m.id\} onClick=\{()=>setMoodId(m.id)\} style=\{\{ display:"flex", flexDirection:"column", alignItems:"center", padding:12, borderRadius:12, border:`2px solid $\{moodId===m.id?m.color:"transparent"\}`, background:C.cardAlt, cursor:"pointer" \}\}><span style=\{\{ fontSize:24 \}\}>\{m.emoji\}</span><span style=\{\{ fontSize:11, fontWeight:700, color:C.text \}\}>\{m.label\}</span></button>)\}\
            </div>\
            <div style=\{\{ display:"flex", gap:10, marginTop:10 \}\}><Btn variant="outline" onClick=\{()=>setStep(0)\}>\uc0\u8592  Back</Btn><Btn onClick=\{save\}>Finish Log Entry</Btn></div>\
          </div>\
        )\}\
      </div>\
    </>\
  );\
\}\
\
