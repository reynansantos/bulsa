                    <button key=\{m.id\} onClick=\{() => setMoodId(moodId === m.id ? null : m.id)\}\
                      style=\{\{\
                        display: "flex", flexDirection: "column", alignItems: "center", gap: 6, padding: "14px 4px",\
                        borderRadius: 14, border: `2px solid $\{moodId === m.id ? m.color : "transparent"\}`,\
                        background: moodId === m.id ? m.color + "1A" : C.cardAlt, cursor: "pointer", transition: "all 0.15s"\
                      \}\}>\
                      <span style=\{\{ fontSize: 26 \}\}>\{m.emoji\}</span>\
                      <span style=\{\{ fontSize: 11, fontWeight: 700, color: moodId === m.id ? C.text : C.textSub, fontFamily: "DM Sans" \}\}>\{m.label\}</span>\
                    </button>\
                  ))\}\
                </div>\
              </div>\
\
              <div>\
                <SLabel>Attach Receipt / Snapshot (Optional)</SLabel>\
                \{photo ? (\
                  <div style=\{\{ position: "relative", borderRadius: 16, overflow: "hidden", border: `1px solid $\{C.border\}`, height: 180, background: C.cardAlt \}\}>\
                    <img src=\{photo\} alt="Receipt asset" style=\{\{ width: "100%", height: "100%", objectFit: "cover" \}\} />\
                    <button onClick=\{() => setPhoto(null)\} style=\{\{ position: "absolute", top: 10, right: 10, background: "rgba(0,0,0,0.6)", border: "none", color: "#fff", width: 28, height: 28, borderRadius: "50%", cursor: "pointer", fontSize: 16 \}\}>\'d7</button>\
                  </div>\
                ) : (\
                  <PhotoPicker onPhoto=\{setPhoto\} />\
                )\}\
              </div>\
\
              <div style=\{\{ display: "flex", gap: 10, marginTop: 8 \}\}>\
                <Btn variant="outline" onClick=\{() => setStep(0)\}>\uc0\u8592  Back</Btn>\
                <Btn onClick=\{save\} variant="primary">\
                  \{isEdit ? "Save Changes" : "Finish & Log"\}\
                </Btn>\
              </div>\
            </div>\
          )\}\
        </div>\
      </div>\
    </>\
  );\
\}\
\
function ExpenseDetail(\{ expense, onClose, onDelete, onEdit \}) \{\
  const [vis, setVis] = useState(false);\
  const [confirm, setConfirm] = useState(false);\
  useEffect(() => \{ setTimeout(() => setVis(true), 20); \}, []);\
  const close = () => \{ setVis(false); setTimeout(onClose, 300); \};\
\
  const cat = catOf(expense.catId);\
  const mood = moodOf(expense.moodId);\
\
  return (\
    <>\
      <div onClick=\{close\} style=\{\{ position: "fixed", inset: 0, background: C.overlay, zIndex: 220, opacity: vis ? 1 : 0, transition: "opacity 0.25s" \}\} />\
      <div style=\{\{\
        position: "fixed", bottom: 0, left: "50%", transform: `translateX(-50%) translateY($\{vis ? 0 : "110%"\})`,\
        width: "100%", maxWidth: 420, background: C.surface, borderRadius: "26px 26px 0 0",\
        border: `1px solid $\{C.borderLight\}`, borderBottom: "none", zIndex: 221,\
        transition: "transform 0.35s cubic-bezier(0.32,0.72,0,1)", maxHeight: "90vh", overflowY: "auto", padding: "20px 22px 44px"\
      \}\}>\
        <div style=\{\{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 24 \}\}>\
          <Tag color=\{cat.color\}>\{cat.label\}</Tag>\
          <button onClick=\{close\} className="tap-btn" style=\{\{ background: C.card, border: `1px solid $\{C.border\}`, color: C.textSub, width: 32, height: 32, borderRadius: "50%", cursor: "pointer", fontSize: 18, display: "flex", alignItems: "center", justifyContent: "center" \}\}>\'d7</button>\
        </div>\
\
        <div style=\{\{ textAlign: "center", marginBottom: 24 \}\}>\
          <p style=\{\{ margin: "0 0 4px", fontSize: 14, color: C.textSub, fontFamily: "DM Sans" \}\}>\{expense.name\}</p>\
          <h1 style=\{\{ margin: 0, fontSize: 44, fontWeight: 800, color: C.text, fontFamily: "DM Sans,sans-serif", letterSpacing: "-0.02em" \}\}>\{fmt(expense.amount)\}</h1>\
          <p style=\{\{ margin: "6px 0 0", fontSize: 12, color: C.textFaint, fontFamily: "DM Sans" \}\}>\
            \{new Date(expense.ts).toLocaleDateString("en-US", \{ weekday: "long", year: "numeric", month: "long", day: "numeric" \})\} at \{new Date(expense.ts).toLocaleTimeString("en-US", \{ hour: "2-digit", minute: "2-digit" \})\}\
          </p>\
        </div>\
\
        <div style=\{\{ display: "flex", flexDirection: "column", gap: 16, marginBottom: 28 \}\}>\
          \{mood && (\
            <div style=\{\{ background: C.card, padding: 14, borderRadius: 16, border: `1px solid $\{C.border\}`, display: "flex", alignItems: "center", gap: 12 \}\}>\
              <span style=\{\{ fontSize: 32 \}\}>\{mood.emoji\}</span>\
              <div>\
                <p style=\{\{ margin: "0 0 2px", fontSize: 11, fontWeight: 800, color: C.textSub \}\}>Purchase Emotional State</p>\
                <p style=\{\{ margin: 0, fontSize: 14, fontWeight: 700, color: mood.color, fontFamily: "DM Sans" \}\}>You felt \{mood.label\} making this transaction</p>\
              </div>\
            </div>\
          )\}\
\
          \{expense.groceryItems && expense.groceryItems.length > 0 && (\
            <div style=\{\{ background: C.card, padding: 16, borderRadius: 16, border: `1px solid $\{C.border\}` \}\}>\
              <SLabel>Grocery Checklist Breakdown</SLabel>\
              <div style=\{\{ display: "flex", flexDirection: "column", gap: 8, marginTop: 8 \}\}>\
                \{expense.groceryItems.map(item => (\
                  <div key=\{item.id\} style=\{\{ display: "flex", alignItems: "center", gap: 10, fontSize: 13, fontFamily: "DM Sans", color: item.checked ? C.textFaint : C.text \}\}>\
                    <span>\{item.checked ? "\uc0\u9989 " : "\u11036 "\}</span>\
                    <span style=\{\{ textDecoration: item.checked ? "line-through" : "none" \}\}>\{item.text\}</span>\
                  </div>\
                ))\}\
              </div>\
            </div>\
          )\}\
\
          \{expense.photo && (\
            <div>\
              <SLabel>Attached Receipt Copy</SLabel>\
              <div style=\{\{ borderRadius: 16, overflow: "hidden", border: `1px solid $\{C.border\}`, background: C.cardAlt, marginTop: 6 \}\}>\
                <img src=\{expense.photo\} alt="Receipt preview ledger" style=\{\{ width: "100%", maxHeight: 320, objectFit: "contain" \}\} />\
              </div>\
            </div>\
          )\}\
        </div>\
\
        <div style=\{\{ display: "flex", gap: 12 \}\}>\
          \{!confirm ? (\
            <>\
              <Btn variant="outline" onClick=\{() => onEdit(expense)\}>Edit Item</Btn>\
              <Btn style=\{\{ background: "none", border: `1px solid $\{C.coral\}30`, color: C.coral \}\} onClick=\{() => setConfirm(true)\}>Delete</Btn>\
            </>\
          ) : (\
            <div style=\{\{ display: "flex", flexDirection: "column", gap: 10, width: "100%", animation: "scaleIn 0.18s ease" \}\}>\
              <p style=\{\{ margin: 0, fontSize: 12, color: C.coral, fontWeight: 700, textAlign: "center", fontFamily: "DM Sans" \}\}>Are you completely sure? This will delete this record permanently.</p>\
              <div style=\{\{ display: "flex", gap: 10, width: "100%" \}\}>\
                <Btn variant="outline" onClick=\{() => setConfirm(false)\} style=\{\{ flex: 1 \}\}>Cancel</Btn>\
                <Btn onClick=\{() => onDelete(expense.id)\} style=\{\{ background: C.coral, color: "#fff", flex: 1 \}\}>Yes, Delete</Btn>\
              </div>\
            </div>\
          )\}\
        </div>\
      </div>\
    </>\
  );\
\}\
\
function ExpenseCard(\{ exp, onClick \}) \{\
  const cat = catOf(exp.catId);\
  const mood = moodOf(exp.moodId);\
\
  return (\
    <div onClick=\{onClick\} className="tap-btn" style=\{\{\
      display: "flex", alignItems: "center", gap: 14, background: C.card,\
      padding: "14px 16px", borderRadius: 16, border: `1px solid $\{C.border\}`,\
      cursor: "pointer", position: "relative", width: "100%"\
    \}\}>\
      <div style=\{\{\
        width: 44, height: 44, borderRadius: 12, background: cat.color + "16",\
        display: "flex", alignItems: "center", justifyContent: "center", fontSize: 22, flexShrink: 0, border: `1px solid $\{cat.color\}22`\
      \}\}>\
        \{cat.icon\}\
      </div>\
\
      <div style=\{\{ flex: 1, minWidth: 0 \}\}>\
        <div style=\{\{ display: "flex", alignItems: "center", gap: 6 \}\}>\
          <p style=\{\{ margin: 0, fontSize: 14, fontWeight: 700, color: C.text, fontFamily: "DM Sans", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" \}\}>\{exp.name\}</p>\
          \{mood && <span style=\{\{ fontSize: 14, flexShrink: 0 \}\} title=\{`Felt $\{mood.label\}`\}>\{mood.emoji\}</span>\}\
          \{exp.photo && <span style=\{\{ fontSize: 11, color: C.textFaint \}\} title="Has receipt attachment">\uc0\u55357 \u56526 </span>\}\
        </div>\
        <p style=\{\{ margin: "2px 0 0", fontSize: 11, color: C.textSub, fontFamily: "DM Sans" \}\}>\
          \{new Date(exp.ts).toLocaleDateString("en-US", \{ month: "short", day: "numeric" \})\}\
          \{exp.groceryItems && exp.groceryItems.length > 0 && ` \'95 $\{exp.groceryItems.filter(i => i.checked).length\}/$\{exp.groceryItems.length\} checked`\}\
        </p>\
      </div>\
\
      <p style=\{\{ margin: 0, fontSize: 15, fontWeight: 800, color: C.text, fontFamily: "DM Sans", flexShrink: 0 \}\}>\
        \{fmt(exp.amount)\}\
      </p>\
    </div>\
  );\
\}\
\
function HomeScreen(\{ expenses, income, setScreen, setEditExpense, wallets, payday \}) \{\
  const [activeTab, setActiveTab] = useState("today");\
  const [daysToPayday, setDaysToPayday] = useState(0);\
  \
  useEffect(() => \{\
    if (!payday) return;\
    const todayNum = new Date().getDate();\
    let diff = payday - todayNum;\
    if (diff < 0) \{\
      const totalDaysThisMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();\
      diff = (totalDaysThisMonth - todayNum) + payday;\
    \}\
    setDaysToPayday(diff);\
  \}, [payday]);\
\
  const totalSpent = expenses.reduce((s, e) => s + e.amount, 0);\
  const totalWalletAvailable = wallets.reduce((s, w) => s + w.balance, 0);\
\
  const filterExpenses = () => \{\
    if (activeTab === "all") return expenses;\
    const todayStr = new Date().toISOString().split("T")[0];\
    return expenses.filter(e => e.ts.split("T")[0] === todayStr);\
  \};\
\
  const currentList = filterExpenses().sort((a, b) => new Date(b.ts) - new Date(a.ts));\
\
  return (\
    <div className="screen-wrap" style=\{\{ padding: "22px 18px 24px", display: "flex", flexDirection: "column", gap: 16 \}\}>\
      <div style=\{\{ display: "flex", justifyContent: "space-between", alignItems: "center" \}\}>\
        <div>\
          <h2 style=\{\{ margin: 0, fontFamily: "DM Sans,sans-serif", fontSize: 24, fontWeight: 800, color: C.text, letterSpacing: "-0.02em" \}\}>\
            Bulsa <span style=\{\{ color: C.accent, fontWeight: 400, fontSize: 16 \}\}>Tracker</span>\
          </h2>\
          <p style=\{\{ margin: 0, fontSize: 11, color: C.textSub, fontFamily: "DM Sans" \}\}>Hyper-realistic structural smart financial companion</p>\
        </div>\
\
        \{payday && (\
          <div style=\{\{ background: daysToPayday <= 3 ? `$\{C.coral\}14` : `$\{C.lime\}14`, border: `1px solid $\{daysToPayday <= 3 ? C.coral + "30" : C.lime + "30"\}`, padding: "6px 12px", borderRadius: 99 \}\}>\
            <span style=\{\{ fontSize: 11, fontWeight: 800, color: daysToPayday <= 3 ? C.coral : C.lime, fontFamily: "DM Sans", letterSpacing: "0.02em" \}\}>\
              \uc0\u55357 \u56496  Payday in \{daysToPayday\} Day\{daysToPayday !== 1 ? "s" : ""\}\
            </span>\
          </div>\
        )\}\
      </div>\
\
      <div style=\{\{ background: "linear-gradient(135deg, #161616, #0D0D0D)", border: `1px solid $\{C.border\}`, borderRadius: 24, padding: "20px 22px", position: "relative" \}\}>\
        <Orb x="-10%" y="-20px" color=\{C.accent\} size=\{160\} opacity=\{0.15\} />\
        <Orb x="60%" y="40px" color=\{C.lime\} size=\{180\} opacity=\{0.1\} />\
\
        <div style=\{\{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 \}\}>\
          <div>\
            <SLabel>Total Expenses</SLabel>\
            <h3 style=\{\{ margin: 0, fontSize: 28, fontWeight: 800, color: C.accent, fontFamily: "DM Sans", letterSpacing: "-0.02em" \}\}>\{fmt(totalSpent)\}</h3>\
            <p style=\{\{ margin: "2px 0 0", fontSize: 11, color: C.textFaint, fontFamily: "DM Sans" \}\}>Accumulated cycle logs</p>\
          </div>\
          <div style=\{\{ borderLeft: `1px solid $\{C.border\}`, paddingLeft: 16, cursor: "pointer" \}\} onClick=\{() => setScreen("wallets")\}>\
            <div style=\{\{ display: "flex", alignItems: "center", gap: 4 \}\}>\
              <SLabel>Available Monies</SLabel>\
              <span style=\{\{ fontSize: 10, color: C.textSub \}\}>\uc0\u8594 </span>\
            </div>\
            <h3 style=\{\{ margin: 0, fontSize: 28, fontWeight: 800, color: C.green, fontFamily: "DM Sans", letterSpacing: "-0.02em" \}\}>\{fmt(totalWalletAvailable)\}</h3>\
            <p style=\{\{ margin: "2px 0 0", fontSize: 11, color: C.textSub, fontFamily: "DM Sans" \}\}>Across all active wallets</p>\
          </div>\
        </div>\
\
        \{income > 0 && (\
          <div style=\{\{ marginTop: 16, paddingTop: 14, borderTop: `1px solid $\{C.border\}` \}\}>\
            <div style=\{\{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 \}\}>\
              <span style=\{\{ fontSize: 12, fontWeight: 700, color: C.textSub, fontFamily: "DM Sans" \}\}>Total Budget Depletion Rate</span>\
              <span style=\{\{ fontSize: 12, fontWeight: 800, color: (totalSpent / income) > 0.85 ? C.coral : C.text, fontFamily: "DM Sans" \}\}>\
                \{Math.round((totalSpent / income) * 100)\}%\
              </span>\
            </div>\
            <Bar pct=\{(totalSpent / income) * 100\} color=\{(totalSpent / income) > 0.85 ? C.coral : C.gradAccent\} h=\{6\} />\
          </div>\
        )\}\
      </div>\
\
      <div>\
        <div style=\{\{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 \}\}>\
          <div style=\{\{ display: "flex", background: C.card, padding: 3, borderRadius: 10, border: `1px solid $\{C.border\}` \}\}>\
            <button onClick=\{() => setActiveTab("today")\} style=\{\{\
              background: activeTab === "today" ? C.cardAlt : "none", border: "none", color: activeTab === "today" ? C.text : C.textSub,\
              padding: "6px 14px", borderRadius: 8, fontSize: 12, fontWeight: 700, cursor: "pointer", fontFamily: "DM Sans"\
            \}\}>Today</button>\
            <button onClick=\{() => setActiveTab("all")\} style=\{\{\
              background: activeTab === "all" ? C.cardAlt : "none", border: "none", color: activeTab === "all" ? C.text : C.textSub,\
              padding: "6px 14px", borderRadius: 8, fontSize: 12, fontWeight: 700, cursor: "pointer", fontFamily: "DM Sans"\
            \}\}>All History</button>\
          </div>\
\
          <span style=\{\{ fontSize: 11, fontWeight: 700, color: C.textFaint, fontFamily: "DM Sans" \}\}>\
            \{currentList.length\} transaction\{currentList.length !== 1 ? "s" : ""\} found\
          </span>\
        </div>\
\
        \{currentList.length === 0 ? (\
          <div style=\{\{ textAlign: "center", padding: "40px 0", background: C.card, borderRadius: 20, border: `1px dashed $\{C.border\}` \}\}>\
            <p style=\{\{ margin: 0, fontSize: 24 \}\}>\uc0\u55356 \u57155 </p>\
            <p style=\{\{ margin: "6px 0 0", fontSize: 13, color: C.textSub, fontWeight: 700, fontFamily: "DM Sans" \}\}>\
              \{activeTab === "today" ? "No expenditures logged today yet." : "No entries recorded in this file."\}\
            </p>\
          </div>\
        ) : (\
          <div style=\{\{ display: "flex", flexDirection: "column", gap: 10 \}\}>\
            \{currentList.map(e => (\
              <ExpenseCard key=\{e.id\} exp=\{e\} onClick=\{() => setEditExpense(e)\} />\
            ))\}\
          </div>\
        )\}\
      </div>\
    </div>\
  );\
\}}