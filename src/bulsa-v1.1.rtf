                    <span style=\{\{ fontSize: 11, fontWeight: 700, color: isGrocery ? C.lime : C.textSub, fontFamily: "DM Sans" \}\}>Detailed Grocery Checklist?</span>\
                    <Toggle on=\{isGrocery\} setOn=\{setIsGrocery\} color=\{C.lime\} />\
                  </div>\
                </div>\
\
                \{!isGrocery ? (\
                  <div style=\{\{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 10 \}\}>\
                    \{CATS.filter(c => c.id !== "grocery").map(c => (\
                      <button key=\{c.id\} onClick=\{() => setCatId(c.id)\}\
                        style=\{\{\
                          display: "flex", flexDirection: "column", alignItems: "center", gap: 6, padding: "12px 6px",\
                          borderRadius: 14, border: `1px solid $\{catId === c.id ? c.color + "40" : C.border\}`,\
                          background: catId === c.id ? c.color + "14" : C.cardAlt, cursor: "pointer", transition: "all 0.15s"\
                        \}\}>\
                        <span style=\{\{ fontSize: 22 \}\}>\{c.icon\}</span>\
                        <span style=\{\{ fontSize: 11, fontWeight: 700, color: catId === c.id ? C.text : C.textSub, fontFamily: "DM Sans,sans-serif", textAlign: "center" \}\}>\{c.label.split(" ")[0]\}</span>\
                      </button>\
                    ))\}\
                  </div>\
                ) : (\
                  <div style=\{\{ background: C.cardAlt, padding: 14, borderRadius: 14, border: `1px solid $\{C.border\}`, display: "flex", flexDirection: "column", gap: 10 \}\}>\
                    <div style=\{\{ display: "flex", gap: 8 \}\}>\
                      <Inp value=\{gInput\} onChange=\{setGInput\} placeholder="e.g. Milk 150, Eggs 90..." onKeyDown=\{e => e.key === "Enter" && handleAddGItem()\} style=\{\{ background: C.card \}\} />\
                      <button onClick=\{handleAddGItem\} style=\{\{ background: C.lime, border: "none", color: "#000", fontWeight: 800, padding: "0 16px", borderRadius: 12, cursor: "pointer" \}\}>+</button>\
                    </div>\
\
                    \{gItems.length > 0 && (\
                      <div style=\{\{ display: "flex", flexDirection: "column", gap: 6, maxHeight: 150, overflowY: "auto", paddingRight: 4 \}\}>\
                        \{gItems.map(item => (\
                          <div key=\{item.id\} style=\{\{ display: "flex", alignItems: "center", justifyContent: "space-between", background: C.card, padding: "8px 10px", borderRadius: 8, border: `1px solid $\{C.border\}` \}\}>\
                            <div style=\{\{ display: "flex", alignItems: "center", gap: 8, cursor: "pointer" \}\} onClick=\{() => handleToggleGItem(item.id)\}>\
                              <input type="checkbox" checked=\{item.checked\} readOnly style=\{\{ accentColor: C.lime \}\} />\
                              <span style=\{\{ fontSize: 13, fontFamily: "DM Sans", color: item.checked ? C.textFaint : C.text, textDecoration: item.checked ? "line-through" : "none" \}\}>\{item.text\}</span>\
                            </div>\
                            <button onClick=\{() => handleRemoveGItem(item.id)\} style=\{\{ background: "none", border: "none", color: C.coral, cursor: "pointer", fontSize: 12 \}\}>\'d7</button>\
                          </div>\
                        ))\}\
